#!/usr/bin/env bash
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd -- "$project_dir"
if [[ ! -x "$project_dir/.venv/bin/python" ]] || ! "$project_dir/.venv/bin/python" -c 'import PySide6.QtWidgets' >/dev/null 2>&1; then
  unset PYTHONPATH PYTHONHOME
  export PYTHONNOUSERSITE=1
  exec python3.14 -m naatik_next.bootstrap "$@"
fi
unset PYTHONPATH PYTHONHOME
export PYTHONNOUSERSITE=1
exec "$project_dir/.venv/bin/python" -m naatik_next.app "$@"
